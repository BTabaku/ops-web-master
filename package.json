{
  "name": "poll-navigator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "vote": "tsx src/guide-vote.ts",
    "vote:fast": "tsx src/guide-vote.ts --refresh-seconds 4 --min-concurrency 5 --max-concurrency 8",
    "vote:headless": "tsx src/guide-vote.ts --headless true",
    "setup": "npx playwright install chromium",
    "setup:linux": "sudo npx playwright install-deps chromium && npx playwright install chromium",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@playwright/test": "^1.53.0",
    "tsx": "^4.19.4",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "typescript": "^5.8.3"
  }
}
